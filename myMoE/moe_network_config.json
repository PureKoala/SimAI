{
  "network-name": "MoE-H800-400Gbps-Network",
  "description": "MoE推理专用网络配置，4xH800，400Gbps以太网，无NVLink",
  
  "network-topology": {
    "type": "single-node",
    "levels": 1,
    "oversubscription": "1:1",
    "moe-inference-optimized": true,
    "layer-specific-topology": true,
    
    "connections": {
      "pcie": {
        "generation": 5,
        "lanes": 16,
        "bandwidth": "35GB/s"
      },
      "attention-dp-ring": {
        "type": "all-reduce-ring",
        "participants": 4,
        "bandwidth": "35GB/s"
      },
      "ffn-ep-mesh": {
        "type": "all-to-all-mesh", 
        "participants": 4,
        "bandwidth": "35GB/s"
      }
    }
  },
  
  "switches": {
    "pcie-switch": {
      "count": 1,
      "ports": 4,
      "buffer-size": "16MB",
      "type": "PCIe5.0-Switch"
    },
    "network-switch": {
      "count": 1,
      "ports": 4,
      "buffer-size": "64MB",
      "type": "400Gbps-Ethernet-Switch"
    }
  },
  
  "links": {
    "intra-node-pcie": {
      "technology": "PCIe5.0",
      "lanes": 16,
      "bandwidth": "64GB/s",
      "latency": "500ns",
      "count": 4,
      "full-duplex": true,
      "overlap-support": true
    },
    
    "inter-gpu-network": {
      "technology": "400Gbps-Ethernet", 
      "bandwidth": "50GB/s",
      "latency": "2000ns",
      "count": 4,
      "full-duplex": true,
      "overlap-support": true
    }
  },
  
  "network-protocols": {
    "ibgda": {
      "enabled": true,
      "protocol": "IB_GDA",
      "mtu": "4KB",
      "retransmission-timeout": "200us",
      "overlap-capable": true
    },
    
    "rdma": {
      "enabled": false,
      "fallback": true
    },
    
    "nccl": {
      "version": "2.19",
      "tree-threshold": "16KB",
      "ring-threshold": "512KB", 
      "overlap-enabled": true,
      "async-kernels": true,
      "no-nvlink-mode": true
    }
  },
  
  "moe-network-optimization": {
    "expert-placement-aware": true,
    "token-routing-optimization": true,
    "load-balancing-support": true,
    "adaptive-routing": false,
    "inference-mode": true,
    
    "expert-groups": {
      "intra-expert-bandwidth": "64GB/s",
      "inter-expert-bandwidth": "50GB/s", 
      "expert-discovery-latency": "500ns",
      "token-routing-latency": "300ns"
    },
    
    "communication-patterns": {
      "all-to-all-optimization": true,
      "gather-scatter-fusion": true,
      "routing-table-caching": true,
      "predictive-prefetching": false
    }
  },
  
  "overlap-network-features": {
    "multi-rail": {
      "enabled": false,
      "rails-per-connection": 1
    },
    
    "pipeline-support": {
      "enabled": true,
      "depth": 2,
      "chunk-size": "8MB"
    },
    
    "async-progress": {
      "enabled": true,
      "progress-threads": 1,
      "completion-polling": "adaptive"
    },
    
    "memory-registration": {
      "pre-registered-pools": true,
      "pool-size": "512MB",
      "lazy-deregistration": true
    }
  },
  
  "qos-configuration": {
    "traffic-classes": {
      "expert-routing": {
        "priority": "highest",
        "bandwidth-guarantee": "50%",
        "latency-target": "5us"
      },
      
      "data-parallel": {
        "priority": "medium",
        "bandwidth-guarantee": "30%", 
        "latency-target": "20us"
      },
      
      "control-messages": {
        "priority": "high",
        "bandwidth-guarantee": "20%",
        "latency-target": "1us"
      }
    }
  },
  
  "congestion-control": {
    "algorithm": "DCQCN",
    "parameters": {
      "kmin": 160,
      "kmax": 1000,
      "pmax": 0.02,
      "dcqcn-g": 0.00390625,
      "dcqcn-ai": 10,
      "dcqcn-hai": 100
    },
    
    "h800-specific": {
      "pcie-traffic-shaping": true,
      "network-priority-queuing": true,
      "inference-load-aware": true
    }
  },
  
  "performance-monitoring": {
    "overlap-metrics": {
      "compute-utilization": true,
      "communication-utilization": true, 
      "overlap-efficiency": true,
      "inference-latency": true
    },
    
    "moe-metrics": {
      "expert-load-balance": true,
      "token-routing-efficiency": true,
      "expert-discovery-latency": true,
      "cross-expert-bandwidth": true
    }
  },
  
  "protocols": {
    "IB_GDA": {
      "bandwidth": "400Gbps",
      "mtu": "4096",
      "congestion-control": "DCQCN"
    }
  },
  
  "overlap-optimization": {
    "enabled": true,
    "pipelining": true,
    "async-communication": true,
    "compute-overlap": true
  }
}
