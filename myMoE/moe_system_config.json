{
  "system-name": "MoE-Inference-H800-Config",
  "description": "MoE推理框架配置 - 4xH800,无NVLink,400Gbps网络",
  "scheduling-policy": "FIFO",
  "endpoint-delay": "500ns",
  "active-chunks-per-dimension": 4,
  "preferred-dataset-splits": 8,
  "boost-mode": 1,
  
  "workload_type": "moe_inference",
  "total_gpus": 4,
  "gpu_type": "NVIDIA H800 80GB HBM3",
  
  "parallelism": {
    "attention_data_parallel": 4,
    "ffn_expert_parallel": 4,
    "tensor_parallel": 1,
    "pipeline_parallel": 1,
    "layer_specific_parallelism": true
  },
  
  "models": {
    "qwen3_235b": {
      "num_experts": 128,
      "experts_activated": 8,
      "hidden_size": 12288,
      "num_layers": 84,
      "attention_heads": 96,
      "vocab_size": 151936
    },
    "qwen3_30b": {
      "num_experts": 128,
      "experts_activated": 8,
      "hidden_size": 7168,
      "num_layers": 48,
      "attention_heads": 56,
      "vocab_size": 151936
    },
    "phi_mini_moe": {
      "num_experts": 16,
      "experts_activated": 2,
      "hidden_size": 4096,
      "num_layers": 32,
      "attention_heads": 32,
      "vocab_size": 50304
    }
  },
  
  "parallelism-details": {
    "attention-layer-parallel": {
      "type": "DP",
      "dimension": 4,
      "communication-pattern": "all-reduce",
      "synchronization": "synchronous",
      "overlap-computation": true,
      "apply-to": ["attention", "layer-norm", "residual"]
    },
    
    "ffn-layer-parallel": {
      "type": "EP", 
      "dimension": 4,
      "communication-pattern": "all-to-all",
      "token-routing": "top-k-routing",
      "load-balancing": true,
      "overlap-computation": true,
      "apply-to": ["moe-ffn", "expert-routing", "expert-computation"]
    }
  },
  
  "h800-hardware-config": {
    "gpu-specs": {
      "compute-capability": "9.0",
      "memory-size": "80GB",
      "memory-bandwidth": "3.35TB/s",
      "compute-performance": "989TFlops",
      "pcie-generation": 5,
      "pcie-lanes": 16,
      "pcie-bandwidth": "35GB/s"
    },
    
    "interconnect": {
      "intra-node": "PCIe-5.0",
      "inter-node": "400Gbps-Ethernet",
      "nvlink": false,
      "rdma": false
    },
    
    "memory-optimization": {
      "expert-caching": true,
      "activation-checkpointing": false,
      "gradient-accumulation": false,
      "mixed-precision": "fp16"
    }
  },
  
  "inference-optimization": {
    "batch-size": 8,
    "sequence-length": 4096,
    "kv-caching": true,
    "attention-optimization": "flash-attention-2",
    "expert-parallelism-only": true,
    "prefill-decode-separation": true
  },
  
  "communication-overlap": {
    "enabled": true,
    "strategies": [
      "computation-communication-overlap",
      "multi-stream-execution", 
      "pipeline-parallelism",
      "asynchronous-allreduce"
    ],
    
    "overlap-efficiency-targets": {
      "attention-layers": 0.70,
      "expert-routing": 0.85,
      "expert-computation": 0.75,
      "output-projection": 0.65
    }
  },
  
  "monitoring": {
    "enable-profiling": true,
    "metrics": [
      "compute-utilization",
      "communication-utilization", 
      "memory-utilization",
      "overlap-efficiency",
      "throughput",
      "latency"
    ],
    
    "logging": {
      "level": "INFO",
      "overlap-details": true,
      "performance-breakdown": true
    }
  }
}
